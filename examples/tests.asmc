; ==============================================================================
; AssemblyCraft (ASMC) Feature Test Suite
; Tests: Data directives, stack, arithmetic, jumps, subroutines, & syscalls
; ==============================================================================

section .data
    ; --- Data Allocation Directives ---
    small_str  ds "Data Small (16b)\n"   ; ds directive: 16 bytes allocation
    med_msg    dm "ASMC Test Suite\t\n" ; dm directive: 32 bytes allocation (\t, \n)
    big_buffer db 0                    ; db directive: 64 bytes allocation
    
    prompt     dm "Enter test text: "
    echo_lbl   ds "You entered: "
    pass_msg   dm "All tests passed!\n"
    fail_msg   ds "Test failed!\n"

section .text
main:
    ; --------------------------------------------------------------------------
    ; 1. Basic System Call & Data Transfer
    ; --------------------------------------------------------------------------
    ; Print welcome message (sys_write = 1)
    mov rax, 1
    mov rdi, med_msg
    syscall

    ; Prompt for user input
    mov rax, 1
    mov rdi, prompt
    syscall

    ; Read user input into rax (sys_read = 2)
    mov rax, 2
    syscall
    mov rbx, rax          ; Save input handle/address into rbx

    ; Print echo label and user input
    mov rax, 1
    mov rdi, echo_lbl
    syscall

    mov rax, 1
    mov rdi, rbx
    syscall

    ; --------------------------------------------------------------------------
    ; 2. Stack Operations (push / pop)
    ; --------------------------------------------------------------------------
    mov rcx, 0x1234       ; Store value in rcx
    push rcx              ; Decrements rsp by 4, pushes 32-bit value
    mov rcx, 0            ; Clear rcx
    pop rdx               ; Increment rsp by 4, pops value into rdx (rdx = 0x1234)

    ; --------------------------------------------------------------------------
    ; 3. Arithmetic & Logical Operations
    ; --------------------------------------------------------------------------
    mov rax, 10
    mov r11, 5
    
    add rax, r11          ; rax = 10 + 5 = 15
    sub rax, 3            ; rax = 15 - 3 = 12
    mul rax, 2            ; rax = 12 * 2 = 24
    div rax, 4            ; rax = 24 // 4 = 6
    
    mov r12, 0xFF
    xor r12, 0xFF         ; r12 = 0x00 (Bitwise XOR clear)

    ; --------------------------------------------------------------------------
    ; 4. Register Utilization & Subroutine Call (call / ret)
    ; --------------------------------------------------------------------------
    mov r8, 20            ; arg5 alias
    mov r9, 30            ; arg6 alias
    call add_values       ; Call subroutine (pushes IP, jumps)
    ; rax should now equal 50

    mov rbp, rax          ; Store result in base pointer register rbp

    ; --------------------------------------------------------------------------
    ; 5. Comparison & Conditional Jumps
    ; --------------------------------------------------------------------------
    ; Test 1: Equal comparison (je, jle, jge)
    mov r13, 50
    cmp rbp, r13          ; Compare 50 and 50 (zf = True, sf = False)
    je test_equal_pass
    jmp test_failed

test_equal_pass:
    jle test_le_pass      ; True because zf == True
    jmp test_failed

test_le_pass:
    jge test_ge_pass      ; True because sf == False
    jmp test_failed

test_ge_pass:
    ; Test 2: Inequality & Greater/Less comparisons (jne, jl, jg)
    mov r14, 10
    mov r15, 20

    cmp r14, r15          ; Compare 10 and 20 (zf = False, sf = True)
    jne test_ne_pass      ; True because zf == False
    jmp test_failed

test_ne_pass:
    jl test_jl_pass       ; True because sf == True and zf == False
    jmp test_failed

test_jl_pass:
    cmp r15, r14          ; Compare 20 and 10 (zf = False, sf = False)
    jg test_jg_pass       ; True because zf == False and sf == False
    jmp test_failed

test_jg_pass:
    ; Print success message
    mov rax, 1
    mov rdi, pass_msg
    syscall

    jmp exit_program      ; Unconditional jump to termination

; ------------------------------------------------------------------------------
; Subroutines & Error Handling
; ------------------------------------------------------------------------------
add_values:
    mov rax, r8
    add rax, r9
    ret                   ; Pops IP and returns

test_failed:
    mov rax, 1
    mov rdi, fail_msg
    syscall

    mov rax, 0            ; sys_exit
    mov rdi, 1            ; Return exit code 1 (error)
    syscall

exit_program:
    mov rax, 0            ; sys_exit
    mov rdi, 0            ; Return exit code 0 (success)
    syscall