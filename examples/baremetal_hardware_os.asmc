section .data
    os_banner   db "ASMC Bare-Metal Kernel Booted!", 0
    disk_buffer dm 512

section .text
main:
    ; 1. Print the banner first so we can see it!
    mov rdi, os_banner
    mov rax, 1          ; syscall 1 = print string
    syscall

    ; 2. Write 1 to MMIO_DISPLAY_MODE (0xFF008)
    mov rdi, 0xFF008
    mov rax, 1
    mov r0, 6           ; syscall 6 = MMIO Write (if you add it)
    syscall

    ; 3. Trigger Disk Read
    mov rdi, 0xFF010    ; MMIO_DISK_SECTOR
    mov rax, 1
    mov r0, 6
    syscall

    mov rdi, 0xFF014    ; MMIO_DISK_ADDR
    mov rax, disk_buffer
    mov r0, 6
    syscall

    mov rdi, 0xFF018    ; MMIO_DISK_CMD
    mov rax, 1
    mov r0, 6
    syscall

    ; 4. Halt
    mov rax, 0
    syscall